{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudreal.github.io/longrca-bench/data/leaderboard.schema.json",
  "title": "LongRCA Bench leaderboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "evaluation_split",
    "generated_at",
    "paper_url",
    "dataset_url",
    "sort",
    "results"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "benchmark": { "const": "LongRCA Bench" },
    "evaluation_split": { "const": "public" },
    "generated_at": { "type": "string", "format": "date" },
    "paper_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "dataset_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction"],
      "properties": {
        "metric": { "const": "root_exact" },
        "direction": { "const": "descending" }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 1140 },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "model",
        "n",
        "role_correct",
        "root_exact_correct",
        "root_within_5_correct",
        "root_mae",
        "valid_step_n",
        "failed_n",
        "date",
        "status",
        "links"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "method": { "type": "string", "minLength": 1 },
        "model": { "const": "DeepSeek-V4-Flash" },
        "n": { "const": 1140 },
        "role_correct": { "$ref": "#/$defs/count" },
        "root_exact_correct": { "$ref": "#/$defs/count" },
        "root_within_5_correct": { "$ref": "#/$defs/count" },
        "root_mae": { "type": "number", "minimum": 0 },
        "valid_step_n": { "$ref": "#/$defs/count" },
        "failed_n": { "$ref": "#/$defs/count" },
        "date": { "type": "string", "format": "date" },
        "status": { "const": "Paper Result" },
        "links": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
